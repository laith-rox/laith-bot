FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir tzdata requests

COPY bridge_real_signal_worker.py test_bridge_real_signal_worker.py ./
COPY real_analysis_engine.py adaptive_sniper_engine.py multi_timeframe_structure.py technical_confirmation.py ./

COPY gigi_profit_protection.py test_gigi_profit_protection.py ./
COPY gigi_regime.py test_gigi_regime.py ./
COPY gigi_intermarket.py test_gigi_intermarket.py ./
COPY gigi_macro.py test_gigi_macro.py ./
COPY gigi_context.py test_gigi_context.py ./
COPY gigi_learning.py test_gigi_learning.py ./
COPY gigi_liquidity.py test_gigi_liquidity.py ./
COPY gigi_positioning.py test_gigi_positioning.py ./
COPY gigi_volatility.py test_gigi_volatility.py ./
COPY gigi_etf.py test_gigi_etf.py ./
COPY gigi_crowding.py test_gigi_crowding.py ./
COPY gigi_options.py test_gigi_options.py ./
COPY gigi_thesis.py test_gigi_thesis.py ./
COPY gigi_yields.py test_gigi_yields.py ./
COPY gigi_stop_geometry.py test_gigi_stop_geometry.py ./
COPY gigi_quality.py test_gigi_quality.py ./
COPY gigi_validation.py test_gigi_validation.py ./
COPY gigi_execution_quality.py test_gigi_execution_quality.py ./
COPY gigi_exposure.py test_gigi_exposure.py ./
COPY gigi_behavior.py test_gigi_behavior.py ./
COPY gigi_readiness.py test_gigi_readiness.py ./
COPY gigi_replay.py test_gigi_replay.py ./
COPY gigi_evaluation.py test_gigi_evaluation.py ./
COPY gigi_event_response.py test_gigi_event_response.py ./
COPY gigi_clock.py test_gigi_clock.py ./
COPY gigi_drift.py test_gigi_drift.py ./
COPY gigi_session_profile.py test_gigi_session_profile.py ./
COPY gigi_walkforward.py test_gigi_walkforward.py ./
COPY gigi_price_prior.py test_gigi_price_prior.py ./

RUN python -m unittest -v \
    test_bridge_real_signal_worker.py \
    test_gigi_profit_protection.py \
    test_gigi_regime.py \
    test_gigi_intermarket.py \
    test_gigi_macro.py \
    test_gigi_context.py \
    test_gigi_learning.py \
    test_gigi_liquidity.py \
    test_gigi_positioning.py \
    test_gigi_volatility.py \
    test_gigi_etf.py \
    test_gigi_crowding.py \
    test_gigi_options.py \
    test_gigi_thesis.py \
    test_gigi_yields.py \
    test_gigi_stop_geometry.py \
    test_gigi_quality.py \
    test_gigi_validation.py \
    test_gigi_execution_quality.py \
    test_gigi_exposure.py \
    test_gigi_behavior.py \
    test_gigi_readiness.py \
    test_gigi_replay.py \
    test_gigi_evaluation.py \
    test_gigi_event_response.py \
    test_gigi_clock.py \
    test_gigi_drift.py \
    test_gigi_session_profile.py \
    test_gigi_walkforward.py \
    test_gigi_price_prior.py

EXPOSE 8080
CMD ["python","-u","bridge_real_signal_worker.py"]

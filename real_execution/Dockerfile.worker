FROM python:3.12-slim
WORKDIR /app
COPY bridge_real_signal_worker.py test_bridge_real_signal_worker.py test_gigi_profit_protection.py test_gigi_regime.py test_gigi_intermarket.py test_gigi_macro.py test_gigi_context.py test_gigi_learning.py test_gigi_liquidity.py test_gigi_positioning.py test_gigi_volatility.py test_gigi_etf.py test_gigi_crowding.py test_gigi_options.py test_gigi_thesis.py test_gigi_yields.py test_gigi_stop_geometry.py test_gigi_quality.py test_gigi_validation.py test_gigi_execution_quality.py test_gigi_exposure.py test_gigi_behavior.py test_gigi_readiness.py test_gigi_replay.py test_gigi_replay.py ./
COPY real_analysis_engine.py adaptive_sniper_engine.py multi_timeframe_structure.py technical_confirmation.py gigi_profit_protection.py gigi_regime.py gigi_intermarket.py gigi_macro.py gigi_context.py gigi_learning.py gigi_liquidity.py gigi_positioning.py gigi_volatility.py gigi_etf.py gigi_crowding.py gigi_options.py gigi_thesis.py gigi_yields.py gigi_stop_geometry.py gigi_quality.py gigi_validation.py gigi_execution_quality.py gigi_exposure.py gigi_behavior.py gigi_readiness.py gigi_replay.py ./
RUN python -m unittest -v test_bridge_real_signal_worker.py test_gigi_profit_protection.py test_gigi_regime.py test_gigi_intermarket.py test_gigi_macro.py test_gigi_context.py test_gigi_learning.py test_gigi_liquidity.py test_gigi_positioning.py test_gigi_volatility.py test_gigi_etf.py test_gigi_crowding.py test_gigi_options.py test_gigi_thesis.py test_gigi_yields.py test_gigi_stop_geometry.py test_gigi_quality.py test_gigi_validation.py test_gigi_execution_quality.py test_gigi_exposure.py test_gigi_behavior.py test_gigi_readiness.py
EXPOSE 8080
CMD ["python","-u","bridge_real_signal_worker.py"]
